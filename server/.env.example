NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cms_user:replace_me@127.0.0.1:5432/detki_cms?schema=public
ADMIN_ORIGIN=http://localhost:3001
PUBLIC_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=cms_session
SESSION_TTL_HOURS=12
CSRF_COOKIE_NAME=cms_csrf
# Production: use 32 random bytes encoded as base64url and share the same secret across instances.
CSRF_HMAC_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=false
LOG_LEVEL=info
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_ROOT=./storage
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/api/v1/public/media
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
ALLOWED_VIDEO_HOSTS=youtube.com,www.youtube.com,youtu.be,vimeo.com,player.vimeo.com
